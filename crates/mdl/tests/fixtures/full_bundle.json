    "commands": {
      "eps.load_table": {
        "description": "Load a table into one of the power system's slots",
        "arguments": [
          { "name": "table", "type": "bytes" },
          { "name": "slot", "type": "u64", "range": { "max": 7 }, "default": 0 }
        ]
      },
      "eps.set_mode": {
