<?xml version="1.0" encoding="UTF-8"?>
<!-- Vendor X's first flight software: housekeeping in millivolts, no
     DETUMBLE mode, and a FIRE that always takes a pulse length. -->
<SpaceSystem name="VendorX" xmlns="http://www.omg.org/spec/XTCE/20180204">
  <TelemetryMetaData>
    <ParameterTypeSet>
      <FloatParameterType name="Millivolts">
        <UnitSet><Unit>V</Unit></UnitSet>
        <IntegerDataEncoding sizeInBits="16">
          <DefaultCalibrator><PolynomialCalibrator>
            <Term coefficient="0" exponent="0"/><Term coefficient="0.001" exponent="1"/>
          </PolynomialCalibrator></DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
    </ParameterTypeSet>
    <ParameterSet>
      <Parameter name="BusVoltage" parameterTypeRef="Millivolts">
        <AliasSet><Alias nameSpace="MDL" alias="eps.bus_voltage"/></AliasSet>
      </Parameter>
    </ParameterSet>
    <ContainerSet>
      <SequenceContainer name="HK">
        <EntryList><ParameterRefEntry parameterRef="BusVoltage"/></EntryList>
      </SequenceContainer>
    </ContainerSet>
  </TelemetryMetaData>
  <CommandMetaData>
    <ArgumentTypeSet>
      <EnumeratedArgumentType name="Mode">
        <IntegerDataEncoding sizeInBits="8"/>
        <EnumerationList>
          <Enumeration value="0" label="SAFE"/>
          <Enumeration value="1" label="NOMINAL"/>
        </EnumerationList>
      </EnumeratedArgumentType>
      <IntegerArgumentType name="Target" signed="false">
        <IntegerDataEncoding sizeInBits="16"/>
      </IntegerArgumentType>
      <IntegerArgumentType name="Pulse" signed="false">
        <UnitSet><Unit>ms</Unit></UnitSet>
        <IntegerDataEncoding sizeInBits="16"/>
        <ValidRangeSet><ValidRange minInclusive="50" maxInclusive="1000"/></ValidRangeSet>
      </IntegerArgumentType>
    </ArgumentTypeSet>
    <MetaCommandSet>
      <MetaCommand name="SetMode">
        <AliasSet><Alias nameSpace="MDL" alias="sys.set_mode"/></AliasSet>
        <ArgumentList><Argument name="mode" argumentTypeRef="Mode"/></ArgumentList>
        <CommandContainer name="SetMode">
          <EntryList>
            <FixedValueEntry name="Opcode" binaryValue="01" sizeInBits="8"/>
            <ArgumentRefEntry argumentRef="mode"/>
          </EntryList>
        </CommandContainer>
      </MetaCommand>
      <MetaCommand name="Fire">
        <AliasSet><Alias nameSpace="MDL" alias="effector.fire"/></AliasSet>
        <ArgumentList>
          <Argument name="target_id" argumentTypeRef="Target"/>
          <Argument name="pulse_ms" argumentTypeRef="Pulse"/>
        </ArgumentList>
        <CommandContainer name="Fire">
          <EntryList>
            <FixedValueEntry name="Opcode" binaryValue="02" sizeInBits="8"/>
            <ArgumentRefEntry argumentRef="target_id"/>
            <ArgumentRefEntry argumentRef="pulse_ms"/>
          </EntryList>
        </CommandContainer>
      </MetaCommand>
    </MetaCommandSet>
  </CommandMetaData>
</SpaceSystem>
