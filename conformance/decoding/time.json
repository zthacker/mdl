  "cases": [
    {
      "name": "cuc-on-tai-with-a-truncated-fraction",
      "spec": ["decoding.md §8", "decoding.md §8.1"],
      "note": "The coarse time is 0x80afd2e5 = 2159006437 s from 1958-01-01 on the tai scale, the fine time 0x0001 of 2^16, floor(1 x 10^9 / 65536) = 15258 ns. The label is 1958-01-01T00:00:00 plus that, 2026-06-01T12:00:37.000015258 TAI, and TAI - UTC is 37 s then: 2026-06-01T12:00:00.000015258Z.",
      "family": "tcuc",
      "message": { "hex": "80 af d2 e5 00 01", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
      "decoded": {
        "family": "tcuc",
        "native_id": "clock-1",
        "asset": "clock-1",
        "stand_in": true,
        "set": "tcuc_v1",
        "packet": "T",
        "event_time": { "kind": "at", "time": "2026-06-01T12:00:00.000015258Z" },
        "booted": null,
        "samples": [],
        "record": { "head": 128 },
        "engineering": [
          { "path": "head", "value": 128, "quality": "good" }
        ]
      }
    },
    {
      "name": "a-tai-label-inside-a-leap-second",
      "spec": ["decoding.md §8", "decoding.md §8.1"],
      "note": "1861920036.5 s from the epoch is the label 2017-01-01T00:00:36.5 TAI. The 2017-01-01 entry's start plus the previous offset, 36 s, is at or before it, and its start plus its own 37 s after it, so it falls inside that entry's leap second, 2016-12-31T23:59:60 UTC, and is the instant before the entry starts: 2016-12-31T23:59:59.999999999Z.",
      "family": "tcuc",
      "message": { "hex": "6e fa a5 24 80 00", "metadata": {}, "ground_time": "2017-01-01T00:00:00Z" },
      "decoded": {
        "family": "tcuc",
        "native_id": "clock-1",
        "asset": "clock-1",
        "stand_in": true,
        "set": "tcuc_v1",
        "packet": "T",
        "event_time": { "kind": "at", "time": "2016-12-31T23:59:59.999999999Z" },
        "booted": null,
        "samples": [],
        "record": { "head": 110 },
        "engineering": [
          { "path": "head", "value": 110, "quality": "good" }
        ]
      }
    },
    {
      "name": "the-tai-label-after-the-leap-second",
      "spec": ["decoding.md §8.1"],
      "note": "A second later the label is 2017-01-01T00:00:37 TAI, the entry's start plus its own 37 s, so 37 s applies: 2017-01-01T00:00:00Z.",
      "family": "tcuc",
      "message": { "hex": "6e fa a5 25 00 00", "metadata": {}, "ground_time": "2017-01-01T00:00:00Z" },
      "decoded": {
        "family": "tcuc",
        "native_id": "clock-1",
        "asset": "clock-1",
        "stand_in": true,
        "set": "tcuc_v1",
        "packet": "T",
        "event_time": { "kind": "at", "time": "2017-01-01T00:00:00Z" },
        "booted": null,
        "samples": [],
        "record": { "head": 110 },
        "engineering": [
          { "path": "head", "value": 110, "quality": "good" }
        ]
      }
    },
    {
      "name": "a-cuc-time-past-the-end",
      "spec": ["decoding.md §8"],
      "note": "The packet's one entry, head, fits in 3 bytes, so it extracts; then the CUC time's 6 bytes reach past the end: invalid_time.",
      "family": "tcuc",
      "message": { "hex": "80 af d2", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
      "error": "invalid_time"
    },
    {
      "name": "a-gps-week-and-time-of-week",
      "spec": ["decoding.md §8", "decoding.md §8.1"],
      "note": "The ground time's GPS label is 2026-06-01T12:00:18 (37 - 19 = 18 s ahead of UTC), week G = 2421 since 1980-01-06. week is 373 = 2421 mod 2^10, and c = floor((2421 - 373 + 512) / 1024) = 2, so the week is 373 + 2 x 1024 = 2421. tow is 129618250 ms. The label 1980-01-06 + 2421 weeks + 129618.25 s is 2026-06-01T12:00:18.25 GPS, plus 19 s as TAI, less 37 s: 2026-06-01T12:00:00.25Z.",
      "family": "tgps",
      "message": { "hex": "01 75 07 b9 d1 4a", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
      "decoded": {
        "family": "tgps",
        "native_id": "gps-1",
        "asset": "gps-1",
        "stand_in": true,
        "set": "tgps_v1",
        "packet": "P",
        "event_time": { "kind": "at", "time": "2026-06-01T12:00:00.25Z" },
        "booted": null,
        "samples": [],
        "record": { "week": 373, "tow": 129618250 },
        "engineering": [
          { "path": "week", "value": 373, "quality": "good" },
          { "path": "tow", "value": 129618250, "quality": "good" }
        ]
      }
    },
    {
      "name": "a-gps-week-rolled-over",
      "spec": ["decoding.md §8"],
      "note": "week is 1023. The week congruent to it nearest the ground's week 2421 is 1023 + c x 1024 with c = floor((2421 - 1023 + 512) / 1024) = 1: week 2047. tow 0 makes the label 2019-03-31T00:00:00 GPS, which is 18 s ahead of UTC then: 2019-03-30T23:59:42Z.",
      "family": "tgps",
      "message": { "hex": "03 ff 00 00 00 00", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
      "decoded": {
        "family": "tgps",
        "native_id": "gps-1",
        "asset": "gps-1",
        "stand_in": true,
        "set": "tgps_v1",
        "packet": "P",
        "event_time": { "kind": "at", "time": "2019-03-30T23:59:42Z" },
        "booted": null,
        "samples": [],
        "record": { "week": 1023, "tow": 0 },
        "engineering": [
          { "path": "week", "value": 1023, "quality": "good" },
          { "path": "tow", "value": 0, "quality": "good" }
        ]
      }
    },
    {
      "name": "a-gps-week-just-ahead-of-the-grounds",
      "spec": ["decoding.md §8"],
      "note": "week is 374, one past the ground's week 2421 mod 1024 (373), as a message stamped after a week boundary the ground clock hasn't reached is. c = floor((2421 - 374 + 512) / 1024) = 2, so the week is 374 + 2048 = 2422, a week ahead; without the half cycle it would be a cycle back, 1398. tow 0 makes the label 2026-06-07T00:00:00 GPS: 2026-06-06T23:59:42Z.",
      "family": "tgps",
      "message": { "hex": "01 76 00 00 00 00", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
      "decoded": {
        "family": "tgps",
        "native_id": "gps-1",
        "asset": "gps-1",
        "stand_in": true,
        "set": "tgps_v1",
        "packet": "P",
        "event_time": { "kind": "at", "time": "2026-06-06T23:59:42Z" },
        "booted": null,
        "samples": [],
        "record": { "week": 374, "tow": 0 },
        "engineering": [
          { "path": "week", "value": 374, "quality": "good" },
          { "path": "tow", "value": 0, "quality": "good" }
        ]
      }
    },
    {
      "name": "an-integer-count-of-ms",
      "spec": ["decoding.md §8", "decoding.md §8.1"],
      "note": "t is 1780315200123 ms since 1970-01-01T00:00:00 on the utc scale, Unix time, exactly: 2026-06-01T12:00:00.123Z.",
      "family": "tel",
      "message": { "hex": "01 00 00 01 9e 83 0e 1a 7b", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
      "decoded": {
        "family": "tel",
        "native_id": "count-1",
        "asset": "count-1",
        "stand_in": true,
        "set": "tel_v1",
        "packet": "INT",
        "event_time": { "kind": "at", "time": "2026-06-01T12:00:00.123Z" },
        "booted": null,
        "samples": [],
        "record": { "id": 1, "t": 1780315200123 },
        "engineering": [
          { "path": "id", "value": 1, "quality": "good" },
          { "path": "t", "value": 1780315200123, "quality": "good" }
        ]
      }
    },
    {
      "name": "a-float-count-rounded-down",
      "spec": ["decoding.md §8"],
      "note": "t is the binary64 4.1 ms. Multiplied by 1000000 ns in binary64 it is 4099999.9999999995, rounded down: 4099999 ns after the epoch, 1970-01-01T00:00:00.004099999Z.",
