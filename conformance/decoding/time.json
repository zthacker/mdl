        "samples": [],
        "record": {},
        "engineering": []
      }
    },
    {
      "name": "iso-8601-second-60",
      "spec": ["decoding.md §8"],
      "note": "A seconds value of 60 reads as the last nanosecond of second 59 of that minute: 2016-12-31T23:59:59.999999999Z.",
      "family": "tiso",
      "message": { "json": "{\"t\": \"2016-12-31T23:59:60Z\"}", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
      "decoded": {
