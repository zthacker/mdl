        "set": "tiso_v1",
        "packet": "P",
        "event_time": { "kind": "at", "time": "2016-12-31T23:59:59.999999999Z" },
        "samples": [],
        "record": {},
        "engineering": []
      }
    },
    {
      "name": "iso-8601-year-0000-that-is-0001-in-utc",
      "spec": ["decoding.md §8"],
      "note": "The range check applies to the instant in UTC: 0000-12-31T23:00:00-02:00 is 0001-01-01T01:00:00Z, which is accepted.",
      "family": "tiso",
      "message": { "json": "{\"t\": \"0000-12-31T23:00:00-02:00\"}", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
