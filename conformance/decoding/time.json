        "event_time": { "kind": "at", "time": "0001-01-01T01:00:00Z" },
        "samples": [],
        "record": {},
        "engineering": []
      }
    },
    {
      "name": "iso-8601-past-year-9999-in-utc",
      "spec": ["decoding.md §8"],
      "note": "9999-12-31T23:59:59-01:00 is 10000-01-01T00:59:59 in UTC, past year 9999: invalid_time.",
      "family": "tiso",
      "message": { "json": "{\"t\": \"9999-12-31T23:59:59-01:00\"}", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
