          { "path": "low", "value": "-9223372036854775808", "quality": "good" },
          { "path": "small", "value": -2, "quality": "good" }
        ]
      }
    },
    {
      "name": "signed-forms",
      "spec": ["decoding.md §2.1"],
      "note": "In sign-magnitude, 0x8005 has the sign bit set and magnitude 5, so -5; 0x8000 is the second zero, read as 0. In ones' complement, 0xfffa has the top bit set and is the negative of NOT 0xfffa = 5, so -5; 0xffff is the second zero, read as 0. In two's complement, the default, 0xfffb is 65531 - 65536 = -5.",
      "family": "be",
      "message": { "hex": "03 80 05 ff fa 80 00 ff ff ff fb", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
      "decoded": {
        "family": "be",
        "native_id": "probe-be",
        "asset": "probe-be",
        "stand_in": true,
        "set": "be_v1",
        "packet": "SIGNED",
        "event_time": { "kind": "ground", "time": "2026-06-01T12:00:00Z" },
        "samples": [],
