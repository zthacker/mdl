        "engineering": [
          { "path": "id", "value": 3, "quality": "good" },
          { "path": "sm", "value": -5, "quality": "good" },
          { "path": "oc", "value": -5, "quality": "good" },
          { "path": "sm_zero", "value": 0, "quality": "good" },
          { "path": "oc_zero", "value": 0, "quality": "good" },
          { "path": "tc", "value": -5, "quality": "good" }
        ]
      }
    },
    {
      "name": "floats-and-their-non-finite-values",
      "spec": ["decoding.md §2.1", "decoding.md §7.3", "decoding.md §7.5", "api.md §1", "api.md §3.1"],
      "note": "0x40490fdb is the binary32 nearest pi, 3.1415927410125732421875 exactly, written as the shortest text that reads back as that double: 3.1415927410125732. 0xc00921fb54442d18 is the binary64 -3.141592653589793. 0x7fc00000 is a NaN, and 0xfff0000000000000 negative infinity, each written as its non_finite object with quality non_finite, in the record too. The NaN's sample has quality non_finite and the raw value. 0x80000000 is negative zero, written -0.0 and good.",
      "family": "be",
      "message": {
        "hex": "04 40 49 0f db c0 09 21 fb 54 44 2d 18 7f c0 00 00 ff f0 00 00 00 00 00 00 80 00 00 00",
        "metadata": {},
