    {
      "name": "little-endian-whole-bytes-and-inside-one-byte",
      "spec": ["decoding.md §2.1", "decoding.md §4"],
      "note": "The packet has no identify keys, so it matches every message. In the little-endian family, word is 34 12, least significant byte first, 0x1234 = 4660. high and low lie inside byte 2, a7, so they read as big-endian: 0xa = 10 and 7. long is fe ff ff ff, 0xfffffffe, -2 as 32-bit two's complement. real is 00 00 00 c0, the binary32 0xc0000000 = -2.0, a float whose value is a whole number, which is still written as a float. be_word names its own big-endian order: 12 34 is 4660.",
      "family": "le",
      "message": { "hex": "34 12 a7 fe ff ff ff 00 00 00 c0 12 34", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
      "decoded": {
        "family": "le",
        "native_id": "probe-le",
        "asset": "probe-le",
        "stand_in": true,
        "set": "le_v1",
        "packet": "LE",
        "event_time": { "kind": "ground", "time": "2026-06-01T12:00:00Z" },
        "samples": [
          { "param": "probe.count", "value": 4660, "unit": null, "path": "word", "index": null, "time_offset_ns": null, "quality": "good" },
          { "param": "probe.offset", "value": -2, "unit": null, "path": "long", "index": null, "time_offset_ns": null, "quality": "good" }
        ],
        "record": { "word": 4660, "high": 10, "low": 7, "long": -2, "real": -2.0, "be_word": 4660 },
        "engineering": [
          { "path": "word", "value": 4660, "quality": "good" },
          { "path": "high", "value": 10, "quality": "good" },
          { "path": "low", "value": 7, "quality": "good" },
          { "path": "long", "value": -2, "quality": "good" },
          { "path": "real", "value": -2.0, "quality": "good" },
          { "path": "be_word", "value": 4660, "quality": "good" }
        ]
      }
    },
    {
      "name": "a-value-past-the-end",
      "spec": ["decoding.md §2.1"],
      "note": "BITS has no length, so the payload is the packet. c is bits 23 to 27, and the payload has 24 bits, so reading it is past_end.",
      "family": "be",
      "message": { "hex": "01 b5 3d", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
      "error": "past_end"
    },
    {
      "name": "ascii-above-7f",
      "spec": ["decoding.md §2.2"],
      "note": "label's value is the bytes before its terminator, 41 c1, and ASCII must be below 0x80.",
      "family": "be",
      "message": { "hex": "05 68 c3 a9 6c 6c 6f 41 c1 00 00 00 00 00 00 e9 ff c0 ff ee", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
      "error": "invalid_text"
    },
