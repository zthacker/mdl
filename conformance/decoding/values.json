  "cases": [
    {
      "name": "integers-at-odd-offsets-and-widths",
      "spec": ["decoding.md §2.1", "decoding.md §4", "decoding.md §6", "decoding.md §7.3", "decoding.md §7.5", "api.md §2.2", "api.md §3.1"],
      "note": "Bits count from the top of byte 0. b5 3d 9e is 10110101 00111101 10011110. a is bits 8 to 10, 101 = 5. b is bits 11 to 22, 10101 then 0011110 = 0xa9e = 2718. c is bits 23 to 27, 11001 = 25, which as 5-bit two's complement is 25 - 32 = -7. flag is bit 28, set. The last 3 bits are padding, which the record leaves out. With no bindings, the fixed alias's text is a stand-in asset; with no time source, the event time is the ground time.",
      "family": "be",
      "message": { "hex": "01 b5 3d 9e", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
      "decoded": {
        "family": "be",
        "native_id": "probe-be",
        "asset": "probe-be",
        "stand_in": true,
        "set": "be_v1",
        "packet": "BITS",
        "event_time": { "kind": "ground", "time": "2026-06-01T12:00:00Z" },
        "samples": [
          { "param": "probe.count", "value": 2718, "unit": null, "path": "b", "index": null, "time_offset_ns": null, "quality": "good" },
          { "param": "probe.offset", "value": -7, "unit": null, "path": "c", "index": null, "time_offset_ns": null, "quality": "good" },
          { "param": "probe.flag", "value": true, "unit": null, "path": "flag", "index": null, "time_offset_ns": null, "quality": "good" }
        ],
        "record": { "id": 1, "a": 5, "b": 2718, "c": -7, "flag": true },
        "engineering": [
          { "path": "id", "value": 1, "quality": "good" },
          { "path": "a", "value": 5, "quality": "good" },
          { "path": "b", "value": 2718, "quality": "good" },
          { "path": "c", "value": -7, "quality": "good" },
          { "path": "flag", "value": true, "quality": "good" }
        ]
      }
    },
    {
      "name": "integers-past-2-to-the-53-are-strings",
      "spec": ["decoding.md §2.1", "api.md §1", "api.md §3.1"],
      "note": "at is 0x001fffffffffffff = 2^53 - 1, the largest integer written as a number. past is 0x0020000000000000 = 2^53, written as a decimal string. big is 0xfffffffffffffffe = 2^64 - 2 = 18446744073709551614. low is 0x8000000000000000 as 64-bit two's complement, -2^63 = -9223372036854775808. small is 0xfffe as 16-bit two's complement, -2. A u64 param's good value is the integer, spelled the same way.",
      "family": "be",
      "message": {
        "hex": "02 00 1f ff ff ff ff ff ff 00 20 00 00 00 00 00 00 ff ff ff ff ff ff ff fe 80 00 00 00 00 00 00 00 ff fe",
        "metadata": {},
        "ground_time": "2026-06-01T12:00:00Z"
      },
