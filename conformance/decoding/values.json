    {
      "name": "text-in-each-encoding-and-bytes",
      "spec": ["decoding.md §2.2", "decoding.md §5.2", "api.md §1"],
      "note": "name is 6 bytes of UTF-8, the default: 68 c3a9 6c 6c 6f is h, e acute, l, l, o. label is 8 bytes ending at its terminator 00: the value is 41 42, AB, and the rest is padding that isn't decoded, though ff isn't ASCII. latin is Latin-1, each byte its own code point: e9 is e acute and ff is y diaeresis. blob is 3 bytes, written as hex. rest takes the bytes left, 01 02.",
      "family": "be",
      "message": {
        "hex": "05 68 c3 a9 6c 6c 6f 41 42 00 ff ff ff ff ff e9 ff c0 ff ee 01 02",
        "metadata": {},
        "ground_time": "2026-06-01T12:00:00Z"
