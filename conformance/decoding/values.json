          "nan": { "non_finite": "NaN" },
          "neg_inf": { "non_finite": "-inf" },
          "neg_zero": -0.0
        },
        "engineering": [
          { "path": "id", "value": 4, "quality": "good" },
          { "path": "single", "value": 3.1415927410125732, "quality": "good" },
          { "path": "double", "value": -3.141592653589793, "quality": "good" },
          { "path": "nan", "value": { "non_finite": "NaN" }, "quality": "non_finite" },
          { "path": "neg_inf", "value": { "non_finite": "-inf" }, "quality": "non_finite" },
          { "path": "neg_zero", "value": -0.0, "quality": "good" }
