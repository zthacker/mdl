      "spec": ["decoding.md §2.2"],
      "note": "name is 68 c3 28 6c 6c 6f: c3 starts a two-byte sequence, and 28 isn't a continuation byte, so the UTF-8 isn't valid.",
      "family": "be",
      "message": { "hex": "05 68 c3 28 6c 6c 6f 41 42 00 00 00 00 00 00 e9 ff c0 ff ee", "metadata": {}, "ground_time": "2026-06-01T12:00:00Z" },
      "error": "invalid_text"
    }
