          { "path": "q_int", "value": 255, "quality": "invalid" },
          { "path": "q_str", "value": "9999", "quality": "invalid" },
          { "path": "q_float", "value": -1.0, "quality": "invalid" },
          { "path": "q_both", "value": 10, "quality": "invalid" },
          { "path": "q_inf", "value": { "non_finite": "inf" }, "quality": "non_finite" },
