  "cases": [
    {
      "name": "the-row-in-effect",
      "spec": ["bindings.md §4", "bindings.md §5", "decoding.md §3.3", "api.md §3.1"],
      "note": "The alias reads 00 64 = 100. At 2026-03-01 the row in effect for fleet 100 is row 0, from 2026-01-01: SAT-1, decoded by the set it names, fleet_a. With bindings, stand_in is false.",
      "family": "fleet",
      "message": { "hex": "00 64 05", "metadata": {}, "ground_time": "2026-03-01T00:00:00Z" },
      "decoded": {
        "family": "fleet",
        "native_id": 100,
        "asset": "SAT-1",
        "stand_in": false,
        "set": "fleet_a",
        "packet": "A",
        "event_time": { "kind": "ground", "time": "2026-03-01T00:00:00Z" },
        "samples": [],
        "record": { "id": 100, "v": 5 },
        "engineering": [
          { "path": "id", "value": 100, "quality": "good" },
          { "path": "v", "value": 5, "quality": "good" }
        ]
      }
    },
    {
      "name": "a-row-takes-effect-at-its-instant",
      "spec": ["bindings.md §4"],
      "note": "Row 1 is in effect from its effective_from, inclusive: at exactly 2026-06-01T00:00:00Z fleet 100 is SAT-2, decoded by fleet_b, whose w is 00 05 = 5.",
      "family": "fleet",
      "message": { "hex": "00 64 00 05", "metadata": {}, "ground_time": "2026-06-01T00:00:00Z" },
      "decoded": {
        "family": "fleet",
        "native_id": 100,
        "asset": "SAT-2",
        "stand_in": false,
        "set": "fleet_b",
        "packet": "B",
        "event_time": { "kind": "ground", "time": "2026-06-01T00:00:00Z" },
        "samples": [],
        "record": { "id": 100, "w": 5 },
        "engineering": [
          { "path": "id", "value": 100, "quality": "good" },
          { "path": "w", "value": 5, "quality": "good" }
        ]
      }
    },
    {
      "name": "the-previous-row-until-then",
      "spec": ["bindings.md §4"],
      "note": "Row 0 is in effect until row 1's effective_from, exclusive: a nanosecond before it, fleet 100 is still SAT-1, decoded by fleet_a.",
      "family": "fleet",
      "message": { "hex": "00 64 05", "metadata": {}, "ground_time": "2026-05-31T23:59:59.999999999Z" },
      "decoded": {
        "family": "fleet",
        "native_id": 100,
        "asset": "SAT-1",
        "stand_in": false,
        "set": "fleet_a",
        "packet": "A",
        "event_time": { "kind": "ground", "time": "2026-05-31T23:59:59.999999999Z" },
        "samples": [],
