        "engineering": [
          { "path": "id", "value": 100, "quality": "good" },
          { "path": "v", "value": 5, "quality": "good" }
        ]
      }
    },
    {
      "name": "before-the-first-row",
      "spec": ["bindings.md §4", "decoding.md §3.3"],
      "note": "At 2025-12-31T23:59:59Z no row for fleet 100 is in effect yet, so it is no asset: unknown_asset.",
      "family": "fleet",
      "message": { "hex": "00 64 05", "metadata": {}, "ground_time": "2025-12-31T23:59:59Z" },
      "error": "unknown_asset"
    },
    {
      "name": "a-retired-row",
      "spec": ["bindings.md §4", "decoding.md §3.3"],
      "note": "Row 2 retires fleet 100 from 2026-09-01T00:00:00Z, so at that instant it is no asset: unknown_asset.",
      "family": "fleet",
      "message": { "hex": "00 64 05", "metadata": {}, "ground_time": "2026-09-01T00:00:00Z" },
      "error": "unknown_asset"
    },
    {
      "name": "a-native-id-no-row-binds",
      "spec": ["bindings.md §6", "decoding.md §3.3"],
      "note": "03 e7 is 999, which no row binds, so it is no asset: unknown_asset.",
      "family": "fleet",
      "message": { "hex": "03 e7 05", "metadata": {}, "ground_time": "2026-03-01T00:00:00Z" },
      "error": "unknown_asset"
    },
    {
      "name": "a-binding-to-a-set-the-build-hasnt-got",
      "spec": ["bindings.md §6", "decoding.md §3.3", "api.md §2.1"],
      "note": "Row 3 binds fleet 200 to set fleet_zz, which the build doesn't have: a warning at the open (unknown_set, at the row's set), and its message is unknown_set.",
      "family": "fleet",
      "message": { "hex": "00 c8 05", "metadata": {}, "ground_time": "2026-03-01T00:00:00Z" },
      "error": "unknown_set"
    },
    {
      "name": "a-binding-without-the-set-its-family-needs",
      "spec": ["bindings.md §6", "bindings.md §7", "decoding.md §3.3", "api.md §2.1"],
      "note": "fleet has no version locator, and row 4 binds fleet 300 without a set: a warning at the open (binding_set, at the row, whose set key is missing), and its message is missing_set.",
      "family": "fleet",
      "message": { "hex": "01 2c 05", "metadata": {}, "ground_time": "2026-03-01T00:00:00Z" },
      "error": "missing_set"
    },
    {
      "name": "a-binding-naming-a-set-its-version-chooses",
      "spec": ["bindings.md §6", "decoding.md §3.3", "api.md §2.1"],
      "note": "vfam has a version locator, and row 5 names a set for vfam 5: a warning at the open (binding_set, at the row's set). For a family with a version locator, a binding that names a set is unexpected_set, before the version is read.",
      "family": "vfam",
      "message": { "hex": "05 01", "metadata": { "fmt": 1 }, "ground_time": "2026-03-01T00:00:00Z" },
      "error": "unexpected_set"
