# A ds since
# boot, tied to UTC by SYSTEM_TIME, which carries both clocks.

mdl_version = "2.0"

[[families]]
name       = "drone"
encoding   = "binary"
byte_order = "little"
alias      = { kind = "metadata", name = "sysid" }
metadata   = ["msgid", "sysid"]

[[sets]]
name   = "drone_v1"
family = "drone"

[sets.time]
kind = "boot"
unit = "ms"
clock_fiald = "time_unix_usec"
clock_unit  = "us"
epoch       = 1970-01-01T00:00:00Z
scale       = "utc"
boot_field  = "time_boot_ms"

# ---- SYS_STATUS (msgid 1): noparam added to the catalog: a compatible change, so a rebuild keeps
# every set's identity.

mdl_version = "2.0"

[catalog.params."eps.sent"]
type        = "f64"
unit        = "A"
description = "Solar arr0oay current"
