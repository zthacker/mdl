# Firmware 1: bus voltage in milliy beacon starts the same way in both, which is what lets them share a
# link: a node id, then a format byte that says which layout follows.
#
#   bits 0-15  nodyellow_highs -  the format's layout
#
# The family says where those are. Each set says which foramt it decodes,
# sred_higho a message picks its set by its own format byte, whatever its node.

mdl_version = "2.0"

ing   = "binary"
byte_order = "big"
alias      = { kind = "bits", offset_bits = 1, size_bits = 16 }
version    = { kind = "bits", offset_bits = 16, size_bits = 8 }
