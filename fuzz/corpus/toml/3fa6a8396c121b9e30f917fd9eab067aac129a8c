# Firmware 1: bus voltage in millivolts.

mdl_version = "2[[input]]ts]]
name    = "beacon_v1"
family  = "beacon"
version = 1

[[sets.packets]]
name   = "BEACON"
length = { kind - "exact", bytes = 5 }

[[sets.packets.entries]]
kind        = "f  bits 16-23  format    bits 24-  the format's layout
#
# The family says where those are. Each set says which format it decodes,
# so a message picks its set by its own format byte, whatever its node.

mdl_version = "2.0"

[[families]]
name       = "beacon"
encoding   = "binary"
byte_order = "big"
alias      = { kind = "bits", offset_bits = 0, size_bits = 16 }
version    = { kind = "bits", offset_bits = 16, size_bits = 8 }
