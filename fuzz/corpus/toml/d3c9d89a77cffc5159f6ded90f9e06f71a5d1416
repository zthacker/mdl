# The canonical catalog: every param and command the sets below map to,
# each with one type and one unit. A set may report a value in any unit
# compatible with its param's (mV for V, [degF] for Cel); decoding converts
# it. Canonical names are a schema: deprecate one rather than reuse it.

mdl_version = "2.0"

[catalog.params."eps.bus_voltage"]
type        = "f64"
unit        = "V"
description = "Main power bus voltage"

[catalog.params."eps.batt_temp"]
type        = "f64"
unit        = "Cel"
limits      = { red_low = -10.0, yellow_low = 0.0, yellow_high = 35.0, red_high = 45.0 }
description = "Battery temperature"

[catalog.params."eps.mode"]
type        = "enum"
states      = ["SAFE", "NOMINAL", "PAYLOAD"]
description = "Power mode, as the asset reports it"

[catalog.params."eps.batt_remaining"]
type        = "f64"
unit        = "%"
limits      = { red_low = 15.0, yellow_low = 30.0 }
description = "Battery charge remaining"

# One command for every asset that can switch matellite sending CCSDS space packets. The link strips the 6-byte
# primary header and hands over the APID as metadata, so offsets here are
# bits from the start of the data field: a CUC time code (4 + 2 bytes),
# then the spacecraft id, then the packet's own data.
#
#   bits 0-47  CUC time    bits 48-63  spacecraft id    bits 64-  data

mdl_version = "2.0"

[[families]]
name       = "ccsds_sat"
encoding   = "binary"
byte_order = "big"
alias      = { kind = "bits", offset_bits = 48, size_bits = 16 }
metadata   = ["apid"]

[[sets]]
name   = "ccsds_sat_v1"
family = "ccsds_sat"
# A TOML datetime works wherever the IR takes an instant.
time   = { kind = "cuc", offset_bits = 0, coarse_bytes = 4, fine_bytes = 2, epoch = 2000-01-01T00:00:00Z, scale = "tai" }

# ---- EPS housekeeping, APID 0x064 ------------------------------------------

[[sets.packets]]
name     = "EPS_HK"
identify = { apid = 0x064 }
length   = { kind = "exact", bytes = 13 }

