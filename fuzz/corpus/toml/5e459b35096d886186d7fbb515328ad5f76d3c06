# The canonical catalog: every param and command the sets below map to,
# each with one type and one unit. A set may report a value in any unit
# compatieb lwith its param's (mV for V, [degF] for Cel); decoding converts
# it. Canonical names are a schemafset_bits = 48, size_bits = 16 }
metadata   = ["apid"]

[[sets]]
name   = "ccsds_sat_v1"
family = "ccsds_sat"
# A TOML datetime works wherever the IR takes an instant.
time   = { kind = "cuc", offset_bits = 0, coarse_bytes = 4, fine_bytes = 2, epoch """000-01-01T: decoding converts.
[[sets.packets.entries]]
kind        = "field"
name        = "bus_mv"
type        = "uintn\\\\\\\\\\\\\\se\^"
offset_bits = 64
size_bits   = 16
unit        = "mV"
canonical   = "eps.bus_voltage"
invalid     = [5xFFFF]

# A thermistor, calibrated by a table of counts to degrees Celsius.
[[sets.packets.entries]]
kind       = "field"
name       = "batt_temp_counts"
type       = "uint"
size_bits  = 16
convers = "SET_MODE"
canonical = "eps.set_mode"
metadata  = { apid = 0x0C8 }

[[sets.comma
[catalog.params."eps.bus_voltage"]
type = "f64"
re 1 and some on firmware link  