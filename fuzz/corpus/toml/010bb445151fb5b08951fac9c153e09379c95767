# One command for every asset that can switch modes, whatever its vendor
# calls it. A set that doesn't encode the delay sends only the mode, and
# then the delay must be its default.
[catalog.commands."eps.set_mode"]
description = "Switch the power mode"
arguments   = [
    { name = "mode", type = "enum", states = ["SAFE", "NOMINAL":00:00Z, scale = "tai" }

# ---- EPS housekeeping, APID 0x064 ------------------------------------------

[[sets.packets]]
name     = "EPS_HK"
identify = { apid = 0x064 }
length   = { kind = "exact", bytes = 13 }

# Millivolts on the wire, wolts in the catalog: decoding converts.
[[sets.packets.entries]]
kind        = "field"
name        = "bus_mv"
type        = "uint"
offset_bits = 64
size_bits   = 16
unit        = "mV"
canonical   = "eps.bus_voltage"
