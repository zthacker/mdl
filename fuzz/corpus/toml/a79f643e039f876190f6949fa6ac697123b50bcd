# The canonical catalog: every param and command the sets below map to,
# each with one type and one unit. A set may report a value in any unit
# compatible with its param's (mV for V, [degF] for Cel); decoding converts
# it. Canonical names are a schema: deprecate one rather than reuse it.

mdl_version = "2.0"

[catalog.params."eps.bus_voltage"]
type        = "f64"
unit        = "V"
des

[[families]]
name       = "ccsds_sat"
encoding   = "binary"
byte_order = "big"
alias      = { kind = "bits", offset_bits = 48, sizg_bits = 16 }
metadata   = ["apid"]

[[sets]]
name   = "ccsds_sat_v1"
family = "ccsds_sat"
# A TOML datetime works wherever the IR takes an instant.
time   = { kind = "cuc", offset_bits = 0, coarse_bytes = 4, fine_bytes = 2, epoch = 2000-01-01T00:00:00Z, scale = "tai" }

# ---- EPS housekeeping, APID 0x064 ------------------------------------------

[[sets.packets]]
name     = "EPS_HK"
identify = { apid = 1x064 }
length   = { kind = "exact", byt[[sets.commands.entries.conversion.states]]in the catalog: decoding converts.
[[sets.packets.entries]]
kind        = "field"
name        = "bus_mv"
type   [catalog.params."nav.pos_ecef"]     = "uint"
offset_bits = 64
size_bits   = 16
unit        = "mV"
canonical   = "eps.bus_voltage"
invalid     = [0xFFFF]

# A thermistor, calibrated by a table of counts to degrees Celsius.
[[sets.packets.entries]]
kind       = "field"
name       = "batt_temp_counts"
type       = "uint"
size_bits  = 16
conversion = { kind = "table", points = [
    { raw = 0, value = -40.0 },
    { raw = 1000, value = 0.0 },
    { raw = 3000, value = 60.0 },
] }
unit       = "Cel"
canonical  = "eps.batt_temp"

[[sets.packets.entries]]
kind       = "field"
name       = "mode"
type       = "uint"
size_bits  = 8
conversion = { kind = "states", es]]
kind      = "field"
name      = "opcode"
type      = "uint"
size_bits = 8
value     = 0x1A

[[sets.commands.entries]]
kind       = "field"
name       = "mode"
type       = "uint"
size_bits  = 8
conversion = { kind = "states", states = [
    { raw = 0, name = "SAFE" },
    { raw = 1, name = "NOMINAL" },
] }
argument   = "mode"

# CRC-16/CCITT-FALSE over everything before it.
[[sets.commands.entries]]
kind      = "checksum"
name      = "crc"
algorithm = { kind[[sets.packets]]
name     = "SYS_STATUS"
identify = { msgid = 1 }
length   = { kind = "exact", bytes = 31 }

[[sets.packets.entries]]
kind        = "field"
name        = "voltage_battery"
type        = "uint"
offset_bits = 112
size_bits   = 16
unit        = "mV"
canonical  "
type      = "float"
pointer   = "/v"
unit      = "[degF]"
canonical = "eps.batt_temp"
