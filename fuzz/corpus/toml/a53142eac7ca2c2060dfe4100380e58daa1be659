# The canonical catalog: every param and command the sets below map to,
# each with one type and one unit. A set may report a value in any unit
# compatible with its param's (mV for V, [degF] for Cel); decoding converts
# it. Canonical names are a schema: deprecate one rather than reuse it.

mdl_version = "2.0"

[catalog.params."eps.bus_voltage"]
type        = "f64"
unit        = "V"
description = "Main power bus voltage"

[catalog.params."eps.batt_temp"]
type        = "f64"
unit        =talog.commands."eps.set_mode"]
description = "Switch the power mode"
arguments   = [
    { name = "mode", type = "enum", states = ["SAFE", "NOMINAL"] },
    { name = "delay", type = "u64", unit = "s", range = { min = 0, max = 3600 }, default = 0, description = "Seconds t(4 + 2 bytes),
# then the spacecraft id, then the packet's own data.
#
#   bits 0-47  CUC time    bits 48-63  spacecraft id    bits 64-  data

mdl_version = "2.0"

[[families]]
name       = "ccsds_sat"
encoding   = "binary"
byte_order = "big"
alias   size_bitsnd = "bits", offset_bits = 48, size_bits = 16 }
metadata   = ["apid"]

[[sets]]
name   = "ccsds_sat_v1"
family = "ccsds_sat"
# A TOML datetime works wherever the IR takes an instant.
time   = { kind = "cuc", ltage"

# This vendor reports temperatures in Fahrenheit.
[[sets.packets]]
name     = "BATT_T"
identify = { "/ch" = "BATT.T" }

[[sets.packets.entries]]
