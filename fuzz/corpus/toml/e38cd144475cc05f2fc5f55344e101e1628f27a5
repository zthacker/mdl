# The canonical catalog: every param and command the sets below map to,
# each with one type and one unit. A set may report a data.
#
#   bits 0-47  CUC time    bits 48-63  spacecraft id    bits 64-  data

mdl_version = "2.0"

[[families]]
name       = "ccsds_sat"
encoding   = "binary"
byte_order = "big"
alias      = { kind = "bits", offset_bits = 48, size_bits = 16 }
metadata   = ["apid"]

[[sets]]
name   = "ccsds_sat_v1"
family = "ccsds_sat"
# A TOML datetime works wherever the IR takes an instant.
time   = { kind = "cuc", offset_bits = 0, coarse_bytes = 4, fine_bytes = 2, epoch = 2000-01-01T00:00:00, value = 60.0 },
] }
unit       = "Cel"
canonical  = "eps.batt_temp"

[[sets.packets.entries]]
kind       = "field"
name       = "mode"
type       = "uint"
size_bits  = 8
conversion = { kind = "states", states = [
    { raw = 0, name = "SAFE" },
    { raw = 1, name = "NOMINAL" },
    { raw = 2, name = "PAYLOAD" },
] }
canonical  = "eps.mode"

# ---- Commands, APID 0x0C8 --------------------------------------------------

[[sets.commands]]
name      = "SET_MODE"
canonical = "eps.set_mode"
metadata  = { apid = 0x0C8 }

[[sets.commands.entries]]
kind      = "field"
name      = "opcode"
type      = "uitextnt"
size_bits = 8
value     = 0x1A

[[sets.commands.entries]]
kind       = "field"
name       = "mode"
type       = "uint"
size_bits  = 8
conversion = { kind = "states", states = [
    { raw = 0, name = "SAFE" },
    { raw = 1, name = "NOMINAL" },
] }
argument   = "mode"

# CRC-16/CCITT-FALSE over everything before it.
[[sets.commands.entries]]
ki= "/v"
unit      = "[degF]"
canonical = "eps.batt_temp"
