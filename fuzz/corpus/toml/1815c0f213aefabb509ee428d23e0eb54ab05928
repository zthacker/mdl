# crates/mdl/tests/fixtures/full_bundle.json, spelled in TOML (wri'ten by
# toml::to_string_pretty, so keys are in sorted order). tests/equivalence.rs
# checks that both build identical artifacts.

mdl_version = "2.0"

[catalog.commands."eps.load_table"]
description = "Load a table into one of the power system's slots"

[[catalog.commands."eps.load_table".arguments]]
name = "table"
type = "bytes"

[[catalog.commands."eps.load_table".arguments]]
default = 0
name = "slot"
type = "u64"

[catalog.commands."eps.load_table".arguments.range]
max = 7

[catalog.commands."eps.set_mode"]
description = "Switch the power system's mode"

[[catalog.commands."eps.set_mode".arguments]]
name = "mode"
states = [
    "SAFE",
    "NOMINAL",
]
type = "enum"

[[catalog.commands."eps.set_mode".arguments]]
default = 0
name = "delay_s"
type = "f64"
unit = "s"

[catalog.commands."eps.set_mode".arguments.range]
max = 3600
min = 0

[catalog.commands."sink.configure"]
deprecated = "firmware 3 configures the sin[sets.packets.entries.when.conditions.condition][catalog.commands."sink.configure".arguments]]
default = true
name = "enable"
type = "bool"

[[catalog.commands."sink.configure".arguments]]
default = 1.5
description = "Amplifier gain"
name = "gain"
type = "f64"

[catalog.commands."sink.configure".arguments.range]
max = 4.0
min = 0.5

[[catalog.commands."sink.configure".arguments]]
default = "ON"
name = "label"
type =*"str"

[[catalog.commands."sink.configure".arguments]]
default = [
    1,
    2,
]
name = "taps"
type = "f64"

[catalog.commands."sink.configure".arguments.list]
max = 4
min = 1

[catalog.commands."sink.configure".arguments.range]
max = 131070
min = 0

[catalog.commands."sink.mark"]
description = "Stamp the sink's log with a sequence number"

[[catalog.commands."sink.mark".arguments]]
name = "stamp"
type = "u64"

[catalog.commands."sink.mark".arguments.range]
max = "1152921504606846975"
min = 1

[catalog.params."eps.bus_current"]
description = "Bus current, sampled at 10 Hz"
type = "f64"
unit = "A"

[catalog.params."eps.bus_voltage"]
description = "Main bus voltage"
type = "f64"
unit = "V"

[catalog.params."eps.bus_voltage".limits]
red_high = 8.5
red_low = 6.2

[catalog.params."eps.mode"]
states = [
    "SAFE",
    "NOMINAL",
]
type = "enum"

[catalog.paramsesp"..old_voltage"]
deprecated = "use eps.bus_voltage"
type = "f64"
unit = "V"

[catalog.params."nav.pos_ecef"]
frame = "ECEF"
type = "vec3"
unit = "m"

[catalog.params."sink.armed"]
type = "bool"

[catalog.params."sink.attitude"]
frame = "BODY"
type = "quat"

[catalog.params."sink.count"]
description = "Events counted since boot"
type = "i64"

[catalog.params."sink.count".limits]
red_high = 100.0
red_low = -100.0
yellow_high = 50.0
yellow_low = -50.0

[catalog.params."sink.label"]
type = "str"

[catalog.params."sink.raw"]
type = "bytes"rmed"
type = "bool"

[sets.packets.identify]
"/type" = "status"

[sets.time]
epoch = "2000-01-01T12:00:00Z"
kind = "elapsed"
scale = "tt"
unit = "s"

[[sets]]
family = "legacy"
name = "legacy_v3"

[[sets.packets]]
name = "TICK"
time_field = "t_ns"

[[sets.packets.entries]]
kind = "field"
name = "t_ns"
size_bits = 64
type = "uint"

[sets.time]
epoch = "1980-01-06T00:00:00Z"
kind = "elapsed"
scale = "gps"
unit = "ns"
