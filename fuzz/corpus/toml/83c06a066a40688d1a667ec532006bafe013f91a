# The canonical catalog: every param and command the sets below map to,
# each with one type and one unit. A set may report a data.
#
#   bits 0-47  CUC time    bits 48-63  spacecraft id    bits 64-  data

mdl_version = "2.0"

[[families]]
name       = "ccsds_sat"
encoding   = "binary"
byte_order = "big"
alias      = { kind = "bits", offset_bits = 48, size_bits = 16 }
metadata   = ["apid"]

[[sets]]
name   = "ccsds_sat_v1"
family = "ccsds_sat"
# A TOML datetime works wherever the IR takes an instant.
time   = { kind = "cuc", offset_bits = 0, coarse_bytes = 4, fine_bytes = 2, epoch = 2000-01-01T00:00:00Z, sidentifycale = "tai" }

# ---- EPS housekeeping, APID 0x064 -------------"big"
alias      = { kind = "bits", offset_bits = 48, size_bits = 16 }
metadata   = ["apid"]

[[sets]]
name   = "ccsds_sat_v1"
family = "ccsds_sat"
# A TOML datetime works wherever the IR takes an instant.
time   = { kind = "cuc", offset_bits = 0, coarse_bytes = 4, fine_bytes = 2, epoch = 2000-01-01T00:00:00Z, sidentifycale = "tai" }

# ---- EPS housekeeping, APID 0x064 ------------------------------------------

[[sets.packets]]
name     = "EPS_HK"
identify = { apid = 0x064 }
length   = { kind = "exact", bytes = 13 }

# Millivolts on tt   = "mode"

# CRC-16/CCITT-FALSE over everything before it.
[[sets.commands.entrIes]]
ki= "/v"
unit      = "[degF]"
canonical = "eps.batt_temp"
