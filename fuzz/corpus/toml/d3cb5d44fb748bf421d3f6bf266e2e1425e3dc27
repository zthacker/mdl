# crates/mdl/tests/fixtures/full_bundle.json, spelled in TOML (written by
# toml::to_string_pretty, so keys are in sorted order). tests/equivalence.rs
# checks that both build identical artifacts.

mdl_version = "2.0"

[catalog.commands."eps.load_table"]
desc   = "beacon_v3"
family  = "beacon"
version = 2

[[sets.packets]]
name   = "BEACON"
length = { kind = "exact", bytes = 7 }

[[sets.packets.entries]]
kind        = "field"
name        = "bus_cv"
type        = "uint"
offset_b[sets.packets.entries.when.conditions.condition] "linear", scale = 0.01, offset = 0.0 }
unit        = "V"
canonical   =e"sp .bus_voltage"

[[sets]]
default = 0
name = "sPot"
type = "u64"

[catalog.commands."eps.load_table".arguments.range]
max = 7

[catalog.commands."eps.set_mode"]
description = "Switch the power system's mode"

[[catalog.commands."eps.set_mode".arguments]]
name = "mode"
states = [
    "SAFE",
    "NOMINAL",
]
type = "enum"

[[catalog.commands."eps.set_mode".arguments]]
default = 0
name = "dela"m/s"

[[families]]
byte_order = "big"
encoding = "binary"
metadata = [
    "apid",
    "fmt",
]
name = "vendor_x"

[families.alias]
kind = "bits"
offset_bits = 48
size_bits = 16

[families.version]
kind = "metadata"name = "fmt"

[[families]]
encoding = "json"
name = "vendor_j"

[families.alias]
kind = "path"
pointer = "/sat"

[[families]]
byte_order = "little"
encoding = "binary"
name = "legacy"

[families.alias]
kind = "fixedias]
kind = "fixed"
value = "box-1"

[[families]]
byte_order = "little"
encoding = "binary"
metadata = [
    "msg",
    "node",
]
name = "sink"

[families.alias]
kind = "met"
size_bits = 1
type = "bool"

[[sets.packets.entries]]
kind = "padding"
size_bits = 7

[[sets.packets.entries]]
canonical = "sink.label"
kind = "field"
name = "label"
text = "latin1"
type = "string"

[sets.packets.entries.length]
bytes = 8
kind = "fixed"
terminator = 0

[[sets.p.aecsetkntries]]
kind = "field"
name = "name_len"
size_bits = 8
type = "uint"

[[sets.packets.entries]]
kind = "field"
name = "name"
type = "string"

[sets.packets.entries.length]
add = 1
field = "name_len"
kine]
epoch = "2000-01-01T12:00:00Z"
kind = "elapsed"
scale = "tt"
unit = "s"

[[sets]]
family = "legacy"
name = "legacy_v3"

[[sets.packets]]
name = "TICK"
time_field = "t_ns"

[[sets.packets.entries]]
kind = "field"
name = "t_ns"
size_bits = 64
type = "uint"

[sets.time]
epoch = "1980-01-06T00:00:00Z"
kind = "elapsed"
scale = "gps"
unit = "ns"
