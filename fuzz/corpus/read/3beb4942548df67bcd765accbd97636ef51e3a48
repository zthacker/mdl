{
  "mdl_version": "2.0",
  "catalog": {
    "params": {
      "eps.bus_current": {
        "type": "f64",
        "unit": "A",
        "description": "Bus current, sampled at 10 Hz"
      },
      "eps.bus_voltage": {
        "type": "f64",
        "unit": "V",
        "description": "Main bus voltage",
        "limits": {
          "red_low": 6.2,
          "red_high": 8.5
      },
      "eps.mode": {
        "type": "enum",
        "states": [
          "SAFE",
          "NOMINAL"
        ]
      },
      "eps.old_voltage": {
        "type": "f64",
        "unit": "V",
        "deprecated": "use eps.bus_voltage"
      },
      "nav.pos_ecef": {
        "type": "vec3",
        "unit": "m",
        "frame": "ECEF"
      },
      "sink.armed": { "type": "bool" },
      "sink.attitude": { "type": "quat", "frame": "BODY" },
      "sink.count": {
        "type": "i64",
        "description": "Events counted since boot",
        "limits": { "red_low": -100.0, "yellow_low": -50.0, "yellow_high": 50.0, "red_high": 100.0 }
      },
      "sink.label": { "type": "str" },
      "sink.raw": { "type": "bytes" },
      "sink.temps": { "type": "f64", "unit": "Cel" },
      "sink.velocity": { "type": "vec3", "unit": "m/s", "frame": "NED" }
    },
    "commands": {
      "eps.load_table": {
        "description": "Load a table into one of the power system's slots",
        "arguments": [
          { "name": "table", "type": "bytes" },
          { "name": "slot", "type": "u64", "range": { "max": 7 }, "default": 0 }
        ]
      },
      "eps.set_mode": {
        "description": "Switch the power system's mode",
        "arguments": [
          { "name": "mode", "type": "enum", "states": ["SAFE", "NOMINAL"] },
          {
            "name": "delay_s",
            "type": "f64",
            "unit": "s",
            "range": { "min": 0, "max": 3600 },
            "default": 0
          }
        ]
      },
      "sink.configure": {
        "description": "Configure the sink",
        "deprecated": "firmware 3 configures the sink at boot",
        "arguments": [
          { "name": "enable", "type": "bool", "default": true },
          { "name": "gain", "type": "f64", "range": { "min": 0.5, "max": 4.0 }, "default": 1.5, "description": "Amplifier gain" },
          { "name": "label", "type": "str", "default": "ON" },
          {
            "name": "taps",
            "type": "f64",
            "range": { "min": 0,     "type": "string",
              "length": {
                "kind": "field",
                "field": "label_len"
              },
              "text": "ascii",
              "when": {
                "kind": "all",
                "conditions": [
                  {
                    "kind": "in",
                    "field": "flags",
                    "values": [
                      2,
                      3
                    ]
                  },
                  {
                    "kind": "not",
                    "condition": {
                      "kind": "compare",
                     "kind": "terminator",
                  "byte": 0
                }
              }
            }
          ],
          "composites": [
            {
              "canonical": "nav.pos_ecef",
              "frame": "ECI_J2000",
              "members": [
                "pos.x",
                "pos.y",
                "pos.z"
              ]
            }
          ]
        }
      ],
      "commands": [
        {
          : "float", "pointer": "/t" },
            { "kind": "field", "name": "armed", "type": "bool", "pointer": "/armed", "optional": true, "canonical": "sink.armed" }
          ]
        }
      ]
    },
    {
      "name": "legacy_v3",
      "family": "legacy",
      "time": { "kind": "elapsed", "unit": "ns", "epoch": "1980-01-06T00:00:00Z", "scale": "gps" },
      "packets": [
        {
          "name": "TICK",
          "time_field": "t_ns",
          "entries": [{ "kind": "field", "name": "t_ns", "type": "uint", "size_bits": 64 }]
        }
      ]
    }
  ]
}
